  int r,g,b;
  getpixel(cnt2,cnt,&r,&g,&b);

  unsigned char rr,gg,bb;
  fprintf(fp,"%c%c%c", (char)b,(char)g,(char)r);
  if(cnt2==winx-1)
   {
   r=255;
   b=255;
   g=255;
   }
  else if(cnt2&0x00FF)
   {
   r=200;
   g=200;
   b=200;
   }
  //fputc(r,fp);
  //fputc(g,fp);
  //fputc(b,fp);
  }
  for(cnt3=0;cnt3<(winx&3);cnt3++)
   {
   fprintf(fp,"%c",0);
   }
 }

fclose(fp);
}


