int maintime;

maintime = clock();

//printf("dist = %d, ang=%d\n", dist,ang);

if(dist_seats[dist] == 1)
 {
 printf("Unable to split district as it has only 1 seat\n");
 return;
 }

int d1,d2;

d1 = dist_seats[dist]/2;
d2 = dist_seats[dist]-d1;

int tgt_pop;

tgt_pop = (dist_tots[dist]*d1)/dist_seats[dist];

int cur_pop = 0;

int x=0,y=0;

int lx=winx;
int ly=winy;
int hx=0;
int hy=0;

for(x=0;x<winx;x++)
 for(y=0;y<winy;y++)
  {
  if(district[y*winx+x]==dist)
   {
   if(x>hx) hx=x;
   if(x<lx) lx=x;
   if(y>hy) hy=y;
   if(y<ly) ly=y;
   }
  }
if(hx<winx-1) hx++;
if(hy<winy-1) hy++;
