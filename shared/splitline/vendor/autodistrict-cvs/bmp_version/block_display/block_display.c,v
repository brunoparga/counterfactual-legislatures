for(qdr=0; qdr<4;qdr++)
 {
 res = splitquad( dist, qdr, tgt_pop, &d, -1, lx,ly,hx,hy);
 if(qdr==0 || res < bres)
  {
  bres = res;
  bq = qdr;
  bd = d;
  } 
 time2 = clock();
 mergewithlast(dist);
 printf("merge time: %d\n", clock()-time2);
 }

