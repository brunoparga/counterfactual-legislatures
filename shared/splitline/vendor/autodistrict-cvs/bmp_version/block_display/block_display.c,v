void putpixel( int x, int y, int r, int g, int b )
{
static GLbyte p[4];
p[0] = 255;
p[1] = 255;
p[2] = 255;
p[3] = 0;

GLbyte *pix;

//printf("%d,%d\n", x,y);

if (x<0 || x>=winx || y<0 || y>=winy)
  {
  return;
  }

pix = frame + (winx*y + x)*4;

if(r!=-1) *pix = r;
pix++;
if(g!=-1) *pix = g;
pix++;
if(b!=-1) *pix = b;
pix++;
*pix = 0;
}

void getpixel( int x, int y, int *r, int *g, int *b )
{
static GLbyte p[4];
p[0] = 255;
p[1] = 255;
p[2] = 255;
p[3] = 0;

GLbyte *pix;

//printf("%d,%d\n", x,y);

*r=-1;
*g=-1;
*b=-1;

if (x<0 || x>=winx || y<0 || y>=winy)
  {
  return;
  }

pix = frame + (winx*y + x)*4;

*r = (int)(*pix);
pix++;
*g = (int)(*pix);
pix++;
*b = (int)(*pix);
}

void genpoly(int num)
{
int cnt=0,cnt2=0;

while(cnt<num)
