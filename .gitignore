# Layout: shared/ is country-neutral (the districting engine, seat-allocation
# maths, animation, shapefile conversion); usa/ is everything that knows about
# FIPS codes, census file formats, or the number 435.

# Build output.
shared/splitline/bin

# Scratch and logs.
usa/work

# Census source data: 9 GB, fetched from the Wayback Machine. The bytes stay
# out; the manifest that makes them verifiable and re-fetchable is tracked.
# The apportionment tables are the exception -- 104 KB of public-domain federal
# work whose origin URL was never recorded, so tracking the bytes is the only
# way to guarantee they survive.
usa/upstream/*
!usa/upstream/MANIFEST.json
!usa/upstream/MANIFEST.sha256
!usa/upstream/apportionment/

# The plans ARE the content: every district is exact and resolution-free, and
# the pictures are a pure function of them. So plans/ is tracked whole -- it is
# 12 MB of JSON -- and everything derived from it is not.
usa/renders
usa/build

# Browsable views over plans/ and renders/. They hold no content of their own;
# tools/make_views.py rebuilds them. The index is worth keeping, since it says
# what exists without needing the tree.
usa/maps/*
!usa/maps/index.json

__pycache__/
*.pyc
