# Upstream CVS repository, kept locally for provenance. The extracted
# checkout is tracked instead, under splitline/vendor/autodistrict-2007.
autodistrict

# Build output.
splitline/bin

# Scratch and logs. The logs are worth keeping and will move to their own
# tracked directory; until then they stay out.
splitline/work

# Census source data: 9 GB, fetched from the Wayback Machine. Not
# reproducible cheaply, so it wants a tracked manifest rather than the bytes.
splitline/data

# The cut trees ARE the content: every district is exact and resolution-free,
# and the pictures are a pure function of them. So the JSON is tracked and
# everything derived from it -- renders, animations -- is not.
splitline/cache/*
!splitline/cache/*.json
splitline/cache_point/*
!splitline/cache_point/*.json
splitline/cache_anim

# Symlink views over the cache, one tree per population model. They carry no
# content of their own -- run_all.py rebuilds them with --link-only.
splitline/maps_uniform
splitline/maps_point

__pycache__/
*.pyc
